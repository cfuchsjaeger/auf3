{
  "name": "auf3",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/silkscreen": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/ui": "~58.0.28",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.25",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-sensors": "~58.0.5",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-view-shot": "^6.1.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4\n58.0.4",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:db": "bash supabase/tests/run.sh",
    "test:e2e": "bash e2e/run.sh",
    "test:db:supabase": "bash supabase/tests/run-supabase.sh",
    "ios:lokal": "APP_VARIANT=lokal EXPO_NO_GIT_STATUS=1 expo prebuild -p ios --clean && APP_VARIANT=lokal expo run:ios --device --configuration Release",
    "db:types": "supabase gen types --lang typescript --local --workdir e2e > src/lib/database.types.ts",
    "test:e2e:gruppen": "bash e2e/run-gruppen.sh",
    "ios:lokal:dev": "APP_VARIANT=lokal EXPO_NO_GIT_STATUS=1 expo prebuild -p ios --clean && APP_VARIANT=lokal expo run:ios --device"
  },
  "private": true
}
